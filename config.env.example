# ============================================================
# SubConvert Manager 配置文件示例
# 使用方法：cp config.env.example config.env，然后按需修改。
# 所有字段均为可选，留空则使用默认值。
# ============================================================

# 端口：填数字（1-65535），或填 auto 表示安装时自动选择空闲端口
PORT=

# 身份验证（HTTP Basic Auth）
# ⚠️  安装后请在首次访问的 /setup 页面设置，切勿使用默认值。
BASIC_AUTH_USER=
BASIC_AUTH_PASS=

# Session 加密密钥
# 建议使用强随机值，首次 /setup 会自动生成并写入；也可手动指定。
# 示例：SESSION_SECRET=your_random_hex_string_here
SESSION_SECRET=

# 拉取远程订阅的超时时间（秒，默认 15，范围 1-20）
TIMEOUT=

# 数据文件路径（存储订阅链接/节点组，默认 data/sources.json）
DATA_FILE=

# 公共订阅接口鉴权 Token（给客户端订阅链接使用）
# 建议设置，否则公共订阅接口（/pub/...）不可用。
SUB_TOKEN=

# URL 安全后缀：启用后所有访问路径需带此后缀（3-5 位字母数字）
# 示例：URL_SUFFIX=abc12  →  访问 http://host:port/abc12/
# 留空则禁用此功能。
URL_SUFFIX=

# 登录失败锁定策略
# LOGIN_MAX_FAILS：连续失败多少次后锁定（默认 3，范围 1-10）
LOGIN_MAX_FAILS=

# LOGIN_LOCK_SECONDS：锁定时长秒数（默认 900，范围 60-86400）
LOGIN_LOCK_SECONDS=

# 远程订阅最大内容大小（字节，默认 2097152 即 2 MB，范围 256 KB - 10 MB）
MAX_REMOTE_BYTES=

# 远程订阅抓取缓存 TTL（分钟，默认 5，设为 0 禁用缓存）
FETCH_CACHE_TTL=

# 自动从 GitHub 更新时使用的分支（默认 main）
UPDATE_BRANCH=
